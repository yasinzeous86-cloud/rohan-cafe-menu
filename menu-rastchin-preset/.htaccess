# Force UTF-8 Encoding
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .php

# Protect sensitive files: database, sqlite journals (-wal, -shm), env and config files
<FilesMatch "(\.sqlite(-.*)?|\.env|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes
