# Cafe Menu — Apache hardening.
# The database and its write-ahead-log siblings must never be downloadable.
<FilesMatch "^menu\.sqlite">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes
